node_modules/

# ad-hoc npm files at the root — the tools that need a manifest commit their own.
# The root package.json is NOT ad-hoc any more: it is what tells Vercel how to
# build the site, so it is committed. The lock file still is not — there are no
# dependencies to lock.
/package-lock.json

# the published site, assembled from the committed dist/ by tools/build_site.mjs.
# Generated on every deploy, so there is nothing to gain from tracking it.
/public/
tools/scene-editor/package-lock.json

# generated by the scene-editor tests, not source
tools/scene-editor/sample/narration.wav
tools/scene-editor/intro-export.html
tools/scene-editor/shot-*.png

# generated snippets for pasting into a hand-edited draft — regenerate, don't track
HMIS BNTS - Search/script/section-*.docx

# the launcher's intermediate page — the zip beside it is the deliverable
HMIS BNTS - Search/launcher/dist/section-*-index.html

__pycache__/

# the kc-maker's node_modules symlink into the lesson's copy
tools/kc-maker/node_modules
